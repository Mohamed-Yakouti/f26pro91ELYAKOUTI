extends layout

block content
  h1= title
  - let items = results;
  div(class="container-fluid")
    div(class="row m-1")
      each item in items
        div(class="col-sm-2 m-1") 
          | Aircraft Type: #{item.aircraft_type} <br>
          | Capacity: #{item.capacity} <br>
          | Speed: #{item.cruising_speed} km/h